---
interface Props {
  eyebrow: string;
  title: string;
  description: string;
}
const { eyebrow, title, description } = Astro.props;
---

<section class="page-hero">
  <div class="page-hero-inner">
    <div><span class="eyebrow">{eyebrow}</span><h1>{title}</h1></div>
    <p class="page-hero-copy">{description}</p>
  </div>
</section>
