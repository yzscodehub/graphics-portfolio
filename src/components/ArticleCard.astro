---
interface Props {
  title: string;
  description: string;
  moduleId: string;
  href: string;
  date: string;
  dateTime: string;
  moduleLabel?: string;
  level?: string;
  readingMinutes?: number;
  readingTimeSource?: "derived" | "editorial-override";
  locale?: "zh-CN" | "en";
  fullTextLanguage?: "zh-CN" | "en";
}
const {
  title,
  description,
  moduleId,
  href,
  date,
  dateTime,
  moduleLabel,
  level,
  readingMinutes,
  readingTimeSource = "derived",
  locale = "zh-CN",
  fullTextLanguage,
} = Astro.props;

const levelLabel =
  level === "foundation"
    ? locale === "en"
      ? "Foundation"
      : "基础"
    : level === "advanced"
      ? locale === "en"
        ? "Advanced"
        : "进阶"
      : locale === "en"
        ? "Intermediate"
        : "中级";
const readingLabel = readingMinutes
  ? locale === "en"
    ? `${readingTimeSource === "derived" ? "~" : ""}${readingMinutes} min read`
    : `${readingTimeSource === "derived" ? "约 " : ""}${readingMinutes} 分钟阅读`
  : undefined;
const languageLabel =
  fullTextLanguage === "zh-CN" && locale === "en" ? "CHINESE FULL TEXT" : undefined;
const actionLabel =
  locale === "en" ? (fullTextLanguage === "zh-CN" ? "READ CHINESE" : "READ") : "阅读";
---

<article class="card article-card reveal" data-module={moduleId}>
  <div class="article-card__meta">
    <time datetime={dateTime}>{date}</time>
    {moduleLabel && <span>{moduleLabel}</span>}
    {level && <span>{levelLabel}</span>}
  </div>
  <h3>{title}</h3>
  <p>{description}</p>
  <footer class="article-card__footer">
    <span class="article-card__reading">
      {readingLabel}
      {languageLabel && <span>{languageLabel}</span>}
    </span>
    <span class="article-card__action" aria-hidden="true">{actionLabel} ↗</span>
  </footer>
  <a class="card-link" href={href} aria-label={`${actionLabel}: ${title}`}></a>
</article>
