---
import type { Locale } from "../lib/i18n";
import { site } from "../data/site";
import { withBase } from "../lib/urls";

interface Props {
  locale: Locale;
  handle: string;
}

const { locale, handle } = Astro.props;
const year = new Date().getFullYear();
const stageLabel = `STAGE / ${site.features.stage.toUpperCase()}`;
---

<footer class="site-footer">
  <div class="footer-inner">
    <span>© {year} {handle}</span>
    <span
      >{
        locale === "en"
          ? "Built as a graphics systems workbench."
          : "一座持续更新的图形系统工作台。"
      }</span
    >
    <span>{stageLabel}</span>
    <a href={withBase("/THIRD_PARTY_NOTICES.txt")}>THIRD-PARTY</a>
    <span>ASTRO / WEBGPU / WGSL</span>
  </div>
</footer>
