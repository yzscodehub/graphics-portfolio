---
import {
  formatAssetBytes,
  plannedRenderingSources,
  renderingAssets,
  renderingAssetManifest,
} from "../data/rendering-assets";
import type { Locale } from "../lib/i18n";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const isEn = locale === "en";
const totalBytes = renderingAssets.reduce((total, asset) => total + asset.bytes, 0);
const sourceKind = {
  mesh: isEn ? "Model" : "模型",
  texture: isEn ? "Material" : "材质",
  hdri: "HDRI",
} as const;
---

<section class="credits-section section" aria-labelledby="credits-runtime-title">
  <div class="section-inner credits-layout">
    <header class="credits-intro">
      <span class="eyebrow">
        ASSET LEDGER / v{renderingAssetManifest.version} / {renderingAssetManifest.status}
      </span>
      <h2 id="credits-runtime-title">{isEn ? "What ships today" : "当前随站发布的资源"}</h2>
      <p>
        {
          isEn
            ? "Every published rendering asset is self-authored, hashed, budgeted, and checked in production builds. No third-party raw model, HDRI, or texture is bundled today."
            : "当前发布的渲染资源均为自制、可哈希校验且纳入包体预算；目前不随站提交任何第三方原始模型、HDRI 或纹理。"
        }
      </p>
    </header>

    <dl class="credits-budget" aria-label={isEn ? "Published asset budget" : "已发布资源预算"}>
      <div><dt>{isEn ? "Published" : "已发布"}</dt><dd>{formatAssetBytes(totalBytes)}</dd></div>
      <div>
        <dt>{isEn ? "Hard cap" : "硬上限"}</dt><dd>
          {formatAssetBytes(renderingAssetManifest.budget.publicRenderingBytes)}
        </dd>
      </div>
      <div>
        <dt>{isEn ? "Courtyard pack" : "庭院场景包"}</dt><dd>
          {formatAssetBytes(renderingAssetManifest.budget.courtyardGeometryBytes)}
        </dd>
      </div>
    </dl>
  </div>

  <div class="section-inner credits-ledger" role="list">
    {
      renderingAssets.map((asset) => (
        <article class="credits-entry" role="listitem">
          <div class="credits-entry__heading">
            <span class="data-label">{asset.role}</span>
            <h3>{asset.id.replaceAll("-", " ")}</h3>
          </div>
          <dl>
            <div>
              <>
                <dt>{isEn ? "License" : "许可"}</dt>
                <dd>{asset.license}</dd>
              </>
            </div>
            <div>
              <>
                <dt>{isEn ? "Author" : "作者"}</dt>
                <dd>{asset.authors.join(", ")}</dd>
              </>
            </div>
            <div>
              <>
                <dt>{isEn ? "Size" : "大小"}</dt>
                <dd>{formatAssetBytes(asset.bytes)}</dd>
              </>
            </div>
            <div>
              <>
                <dt>SHA-256</dt>
                <dd class="credits-hash">{asset.outputSha256}</dd>
              </>
            </div>
            <div>
              <>
                <dt>{isEn ? "Used by" : "关联 Demo"}</dt>
                <dd>{asset.usedBy.join(" / ")}</dd>
              </>
            </div>
          </dl>
        </article>
      ))
    }
  </div>
</section>

<section
  class="credits-section credits-section--planned section"
  aria-labelledby="credits-planned-title"
>
  <div class="section-inner credits-layout">
    <header class="credits-intro">
      <span class="eyebrow">SOURCE LOCK / CC0</span>
      <h2 id="credits-planned-title">
        {isEn ? "Reviewed sources, not shipped yet" : "已列入计划、尚未随站发布的来源"}
      </h2>
      <p>
        {
          isEn
            ? "These CC0 Poly Haven references are reserved for the future Research Courtyard. They are not downloaded, redistributed, or used by the current Preview. A reviewed source hash is required before any replacement build."
            : "以下 Poly Haven CC0 资源为未来 Research Courtyard 预留；当前 Preview 未下载、未再分发、也未在运行时使用。任何替换构建都必须先记录经审核的源文件哈希。"
        }
      </p>
    </header>
    <p class="credits-status">
      <span aria-hidden="true">●</span>{isEn ? "PLANNED / NOT DOWNLOADED" : "已计划 / 尚未下载"}
    </p>
  </div>

  <div class="section-inner credits-source-grid" role="list">
    {
      plannedRenderingSources.map((source) => (
        <article class="credits-source" role="listitem">
          <span class="data-label">{sourceKind[source.kind]}</span>
          <h3>{source.id.replaceAll("-", " ")}</h3>
          <p>
            {isEn
              ? `Reserved for ${source.usedBy.join(" / ")}.`
              : `计划用于 ${source.usedBy.join(" / ")}。`}
          </p>
          <dl>
            <div>
              <>
                <dt>{isEn ? "License" : "许可"}</dt>
                <dd>{source.license}</dd>
              </>
            </div>
            <div>
              <>
                <dt>{isEn ? "Author" : "作者"}</dt>
                <dd>{source.authors.join(", ")}</dd>
              </>
            </div>
          </dl>
          <a href={source.sourceUrl} target="_blank" rel="noreferrer">
            {isEn ? "View source" : "查看来源"}
          </a>
        </article>
      ))
    }
  </div>
</section>

<style>
  .credits-section {
    border-top: 1px solid var(--line);
  }
  .credits-section--planned {
    background: rgba(255, 255, 255, 0.018);
  }
  .credits-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: clamp(28px, 6vw, 88px);
    align-items: end;
  }
  .credits-intro {
    max-width: 52rem;
  }
  .credits-intro h2 {
    margin-bottom: 16px;
  }
  .credits-intro p,
  .credits-source p {
    color: var(--muted);
  }
  .credits-budget {
    display: grid;
    grid-template-columns: repeat(3, minmax(92px, 1fr));
    margin: 0;
    border: 1px solid var(--line);
  }
  .credits-budget div {
    padding: 12px 14px;
    border-left: 1px solid var(--line);
  }
  .credits-budget div:first-child {
    border-left: 0;
  }
  .credits-budget dt,
  .credits-entry dt,
  .credits-source dt {
    color: var(--dim);
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .credits-budget dd,
  .credits-entry dd,
  .credits-source dd {
    margin: 4px 0 0;
    font-family: var(--font-mono);
    font-size: 0.72rem;
  }
  .credits-ledger {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1px;
    margin-top: 1px;
    background: var(--line);
  }
  .credits-entry {
    padding: 22px;
    background: var(--panel);
  }
  .credits-entry__heading {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
  }
  .credits-entry h3,
  .credits-source h3 {
    margin-bottom: 18px;
    font-size: 1.25rem;
    text-transform: uppercase;
  }
  .credits-entry .data-label,
  .credits-source .data-label {
    margin-bottom: 0;
    font-size: 0.58rem;
  }
  .credits-entry dl {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px 22px;
    margin: 0;
  }
  .credits-entry dl div:last-child {
    grid-column: 1 / -1;
  }
  .credits-hash {
    overflow-wrap: anywhere;
    color: var(--signal);
  }
  .credits-status {
    margin: 0;
    color: var(--amber);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.08em;
    white-space: nowrap;
  }
  .credits-status span {
    margin-right: 8px;
  }
  .credits-source-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1px;
    margin-top: 1px;
    background: var(--line);
  }
  .credits-source {
    display: flex;
    min-height: 230px;
    flex-direction: column;
    padding: 22px;
    background: var(--bg);
  }
  .credits-source h3 {
    margin-top: 10px;
    margin-bottom: 10px;
  }
  .credits-source p {
    margin-bottom: 18px;
    font-size: 0.92rem;
  }
  .credits-source dl {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
    margin: 0 0 22px;
  }
  .credits-source a {
    margin-top: auto;
    color: var(--signal);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .credits-source a::after {
    margin-left: 8px;
    content: "↗";
  }
  @media (max-width: 860px) {
    .credits-layout {
      grid-template-columns: 1fr;
    }
    .credits-budget {
      max-width: 520px;
    }
    .credits-source-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 580px) {
    .credits-budget,
    .credits-entry dl {
      grid-template-columns: 1fr;
    }
    .credits-budget div {
      border-left: 0;
      border-top: 1px solid var(--line);
    }
    .credits-budget div:first-child {
      border-top: 0;
    }
    .credits-ledger,
    .credits-source-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
