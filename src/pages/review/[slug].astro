---
export function getStaticPaths() {
  return import.meta.env.COURTYARD_REVIEW === "1"
    ? [{ params: { slug: "research-courtyard" } }]
    : [];
}
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex,nofollow" />
    <title>Research Courtyard / Local Review</title>
    <style>
      :root {
        color-scheme: dark;
        font-family: "IBM Plex Mono", "Cascadia Mono", monospace;
        background: #090d0d;
        color: #e7e4d8;
      }
      * {
        box-sizing: border-box;
      }
      body {
        margin: 0;
        min-width: 320px;
        background:
          linear-gradient(rgba(104, 255, 207, 0.045) 1px, transparent 1px),
          linear-gradient(90deg, rgba(104, 255, 207, 0.045) 1px, transparent 1px), #090d0d;
        background-size: 24px 24px;
      }
      main {
        width: min(1680px, 100%);
        margin: auto;
        padding: 20px;
      }
      header {
        display: grid;
        grid-template-columns: 1fr auto;
        gap: 20px;
        align-items: end;
        padding: 16px 0 20px;
        border-bottom: 1px solid #30413c;
      }
      .eyebrow,
      label,
      dt {
        color: #78f2c4;
        font-size: 11px;
        letter-spacing: 0.14em;
        text-transform: uppercase;
      }
      h1 {
        margin: 7px 0 0;
        max-width: 16ch;
        font:
          600 clamp(30px, 5vw, 68px)/0.92 "Arial Narrow",
          "IBM Plex Sans Condensed",
          sans-serif;
        letter-spacing: -0.035em;
      }
      .candidate {
        align-self: start;
        border: 1px solid #e3a44a;
        color: #e3a44a;
        padding: 8px 10px;
        font-size: 11px;
        letter-spacing: 0.12em;
      }
      .stage {
        position: relative;
        margin-top: 20px;
        border: 1px solid #30413c;
        background: #030606;
        aspect-ratio: 21 / 9;
        min-height: 360px;
        overflow: hidden;
      }
      canvas {
        display: block;
        width: 100%;
        height: 100%;
      }
      .reticle {
        pointer-events: none;
        position: absolute;
        inset: 14px;
        border: 1px solid rgba(120, 242, 196, 0.22);
      }
      .reticle::before,
      .reticle::after {
        content: "";
        position: absolute;
        background: #78f2c4;
        opacity: 0.45;
      }
      .reticle::before {
        width: 34px;
        height: 1px;
        left: 50%;
        top: 50%;
      }
      .reticle::after {
        width: 1px;
        height: 34px;
        left: 50%;
        top: 50%;
      }
      .hud {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        border: 1px solid #30413c;
        border-top: 0;
      }
      .hud > div {
        min-width: 0;
        padding: 12px 14px;
        border-right: 1px solid #30413c;
      }
      .hud > div:last-child {
        border-right: 0;
      }
      dt {
        margin-bottom: 6px;
      }
      dd {
        margin: 0;
        overflow-wrap: anywhere;
        font-size: 12px;
      }
      #review-state[data-state="ready"] {
        color: #78f2c4;
      }
      #review-state[data-state="error"] {
        color: #dc765f;
      }
      .controls {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 1px;
        margin-top: 20px;
        background: #30413c;
        border: 1px solid #30413c;
      }
      .control {
        display: grid;
        gap: 8px;
        padding: 14px;
        background: #0d1312;
      }
      select,
      input,
      button {
        width: 100%;
        min-height: 38px;
        border: 1px solid #49665d;
        border-radius: 2px;
        background: #090d0d;
        color: #e7e4d8;
        font: inherit;
      }
      button {
        cursor: pointer;
        color: #78f2c4;
        letter-spacing: 0.1em;
      }
      button:hover,
      button:focus-visible,
      select:focus-visible,
      input:focus-visible {
        outline: 2px solid #78f2c4;
        outline-offset: 2px;
      }
      output {
        color: #e3a44a;
      }
      footer {
        display: flex;
        justify-content: space-between;
        gap: 24px;
        margin-top: 20px;
        color: #87938f;
        font-size: 11px;
        line-height: 1.6;
      }
      @media (max-width: 850px) {
        header,
        .hud,
        .controls {
          grid-template-columns: 1fr 1fr;
        }
        .stage {
          min-height: 320px;
          aspect-ratio: auto;
        }
        .hud > div {
          border-bottom: 1px solid #30413c;
        }
      }
      @media (max-width: 520px) {
        main {
          padding: 12px;
        }
        header,
        .hud,
        .controls {
          grid-template-columns: 1fr;
        }
        .candidate {
          justify-self: start;
        }
      }
    </style>
  </head>
  <body>
    <main>
      <header>
        <div>
          <div class="eyebrow">GPU SCENE / AUDIT SURFACE 02</div>
          <h1>Research Courtyard</h1>
        </div>
        <div class="candidate">LOCAL CANDIDATE / NOT PUBLIC EVIDENCE</div>
      </header>
      <section class="stage" aria-label="Research Courtyard WebGPU candidate">
        <canvas id="courtyard-canvas">
          Real-model rendering candidate. Read the status if WebGPU is unavailable.
        </canvas>
        <div class="reticle" aria-hidden="true"></div>
      </section>
      <dl class="hud">
        <div><dt>STATE</dt><dd id="review-state" data-state="loading">BOOT</dd></div>
        <div><dt>BACKEND</dt><dd id="review-backend">PROBING</dd></div>
        <div><dt>INVENTORY</dt><dd id="review-inventory">VERIFYING</dd></div>
        <div><dt>BUDGET</dt><dd id="review-budget">VERIFYING</dd></div>
      </dl>
      <section class="controls" aria-label="Rendering review controls">
        <label class="control">
          LOD
          <select id="review-lod">
            <option value="0">LOD 0</option>
            <option value="1">LOD 1</option>
            <option value="2">LOD 2</option>
          </select>
        </label>
        <label class="control">
          BUFFER
          <select id="review-debug">
            <option value="final">FINAL</option>
            <option value="normal">WORLD NORMAL</option>
            <option value="roughness">ROUGHNESS</option>
            <option value="metalness">METALNESS</option>
          </select>
        </label>
        <label class="control">
          EXPOSURE <output id="review-exposure-value">1.00</output>
          <input id="review-exposure" type="range" min="0.25" max="2.5" step="0.05" value="1" />
        </label>
        <div class="control">
          <span class="eyebrow">FRAME CONTROL</span>
          <button id="review-pause" type="button" aria-pressed="false">PAUSE</button>
        </div>
      </section>
      <footer>
        <span>
          Purpose: inspect geometry, material binding, alpha mask, LOD, SH diffuse, and resource
          lifetime.
        </span>
        <span>Promotion requires visual approval and an RTX acceptance receipt.</span>
      </footer>
    </main>
    <script>
      import "../../demos/research-courtyard/review-app-v2";
    </script>
  </body>
</html>
