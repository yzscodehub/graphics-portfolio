---
import { getCollection, render, type CollectionEntry } from "astro:content";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import PageHero from "../../../components/PageHero.astro";
import DemoShell from "../../../components/DemoShell.astro";
import DemoEvidencePanel from "../../../components/DemoEvidencePanel.astro";
import RelatedWriting from "../../../components/RelatedWriting.astro";
import { profile } from "../../../data/profile";
import { renderingAssetManifest, renderingSourceLock } from "../../../data/rendering-assets";
import { sourceRef } from "../../../data/site";
import { demoRegistry } from "../../../demos/core/registry";
import { withBase, withSourceRef } from "../../../lib/urls";
export async function getStaticPaths() {
  const allEntries = (await getCollection("demos")) as CollectionEntry<"demos">[];
  const entries = allEntries.filter((entry) => entry.data.locale === "en" && !entry.data.draft);
  return entries.map((entry) => ({ params: { slug: entry.data.routeSlug }, props: { entry } }));
}
interface Props {
  entry: CollectionEntry<"demos">;
}
const { entry } = Astro.props;
const { Content } = await render(entry);
const backendLabel = entry.data.backends.map((item: { label: string }) => item.label).join(" / ");
const requirementLabel = entry.data.requirements
  .map((item: string | { label: string }) => (typeof item === "string" ? item : item.label))
  .join(" / ");
const pageUrl = new URL(
  withBase(`/en/demos/${entry.data.routeSlug}/`),
  Astro.site ?? Astro.url.origin,
).toString();
const definition = demoRegistry[entry.data.routeSlug]?.definition;
if (!definition) throw new Error(`Missing Demo registry entry: ${entry.data.routeSlug}`);
const assetLabels = definition.assetIds.map((id) => {
  const record = renderingAssetManifest.assets.find((asset) => asset.id === id);
  return record?.role.includes("placeholder") ? `${id} [PREVIEW PLACEHOLDER]` : id;
});
const sceneState =
  definition.referenceScene === "research-courtyard"
    ? `${renderingAssetManifest.status} / ${renderingSourceLock.policy.stage}`
    : "self-authored contract";
const standaloneHref = `${withBase(`/en/demos/${entry.data.routeSlug}/`)}?standalone=1#demo-runtime`;
---

<BaseLayout
  locale="en"
  title={entry.data.title}
  description={entry.data.summary}
  handle={profile.displayName}
  image={withBase(`/og/demos/${entry.data.routeSlug}.png`)}
  structuredData={{
    "@context": "https://schema.org",
    "@type": "SoftwareSourceCode",
    name: entry.data.title,
    description: entry.data.summary,
    url: pageUrl,
    inLanguage: "en",
    programmingLanguage: ["TypeScript", "WGSL"],
    runtimePlatform: "Web browser",
    creator: { "@type": "Person", name: profile.displayName, sameAs: profile.githubUrl },
  }}
>
  <PageHero
    eyebrow={`DEMO / ${entry.data.backend}`}
    title={entry.data.title}
    description={entry.data.summary}
  />
  <section class="section" data-demo-detail-runtime>
    <div class="section-inner">
      <DemoEvidencePanel
        locale="en"
        technique={`${entry.data.category} / ${entry.data.evidence}`}
        backends={backendLabel}
        modes={definition.modes}
        assetIds={assetLabels}
        sourceUrl={withSourceRef(definition.sourceUrl, sourceRef)}
        standaloneHref={standaloneHref}
        currentLimit={entry.data.currentLimit}
        sceneState={sceneState}
      />
      <DemoShell
        slug={entry.data.routeSlug}
        locale="en"
        title={entry.data.title}
        description={entry.data.summary}
        fallbackImage={entry.data.fallbackImage}
      />
    </div>
  </section>
  <section class="section" data-demo-detail-secondary>
    <div class="section-inner detail-layout">
      <article class="prose"><Content /></article><aside class="detail-aside">
        <dl>
          <div><dt>BACKENDS</dt><dd>{backendLabel}</dd></div><div>
            <dt>MATURITY</dt><dd>{entry.data.maturity}</dd>
          </div><div>
            <dt>EVIDENCE</dt><dd>{entry.data.evidence}</dd>
          </div><div>
            <dt>REQUIREMENTS</dt><dd>{requirementLabel || "BASELINE"}</dd>
          </div><div><dt>CONTROLS</dt><dd>{entry.data.controls.join(" / ") || "NONE"}</dd></div>
          <div><dt>METRIC SOURCE</dt><dd>{entry.data.metricSource.description}</dd></div>
        </dl>
      </aside>
    </div>
  </section>
  <div data-demo-detail-secondary>
    <RelatedWriting locale="en" slugs={entry.data.relatedArticles} />
  </div>
  <script is:inline>
    if (new URLSearchParams(window.location.search).get("standalone") === "1") {
      document.documentElement.classList.add("demo-standalone");
    }
  </script>
</BaseLayout>
