---
import { getCollection, render, type CollectionEntry } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHero from "../../components/PageHero.astro";
import DemoShell from "../../components/DemoShell.astro";
import RelatedWriting from "../../components/RelatedWriting.astro";
import { profile } from "../../data/profile";
import { withBase } from "../../lib/urls";
export async function getStaticPaths() {
  const allEntries = (await getCollection("demos")) as CollectionEntry<"demos">[];
  const entries = allEntries.filter((entry) => entry.data.locale === "zh-CN" && !entry.data.draft);
  return entries.map((entry) => ({ params: { slug: entry.data.routeSlug }, props: { entry } }));
}
interface Props {
  entry: CollectionEntry<"demos">;
}
const { entry } = Astro.props;
const { Content } = await render(entry);
const backendLabel = entry.data.backends.map((item: { label: string }) => item.label).join(" / ");
const requirementLabel = entry.data.requirements
  .map((item: string | { label: string }) => (typeof item === "string" ? item : item.label))
  .join(" / ");
const pageUrl = new URL(
  withBase(`/demos/${entry.data.routeSlug}/`),
  Astro.site ?? Astro.url.origin,
).toString();
---

<BaseLayout
  locale="zh-CN"
  title={entry.data.title}
  description={entry.data.summary}
  handle={profile.displayName}
  image={withBase(`/og/demos/${entry.data.routeSlug}.png`)}
  structuredData={{
    "@context": "https://schema.org",
    "@type": "SoftwareSourceCode",
    name: entry.data.title,
    description: entry.data.summary,
    url: pageUrl,
    inLanguage: "zh-CN",
    programmingLanguage: ["TypeScript", "WGSL"],
    runtimePlatform: "Web browser",
    creator: { "@type": "Person", name: profile.displayName, sameAs: profile.githubUrl },
  }}
>
  <PageHero
    eyebrow={`DEMO / ${entry.data.backend}`}
    title={entry.data.title}
    description={entry.data.summary}
  />
  <section class="section">
    <div class="section-inner">
      <DemoShell
        slug={entry.data.routeSlug}
        locale="zh-CN"
        title={entry.data.title}
        description={entry.data.summary}
        fallbackImage={entry.data.fallbackImage}
      />
    </div>
  </section>
  <section class="section">
    <div class="section-inner detail-layout">
      <article class="prose"><Content /></article><aside class="detail-aside">
        <dl>
          <div><dt>BACKENDS</dt><dd>{backendLabel}</dd></div><div>
            <dt>MATURITY</dt><dd>{entry.data.maturity}</dd>
          </div><div>
            <dt>EVIDENCE</dt><dd>{entry.data.evidence}</dd>
          </div><div>
            <dt>REQUIREMENTS</dt><dd>{requirementLabel || "BASELINE"}</dd>
          </div><div><dt>CONTROLS</dt><dd>{entry.data.controls.join(" / ") || "NONE"}</dd></div>
          <div><dt>METRIC SOURCE</dt><dd>{entry.data.metricSource.description}</dd></div>
        </dl>
      </aside>
    </div>
  </section>
  <RelatedWriting locale="zh-CN" slugs={entry.data.relatedArticles} />
</BaseLayout>
