---
import BaseLayout from "./BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import type { Locale } from "../lib/i18n";

interface Props {
  locale: Locale;
  title: string;
  description: string;
  eyebrow: string;
  handle: string;
  meta?: Array<[string, string]>;
  paper?: boolean;
  image?: string;
  ogType?: "website" | "article";
  structuredData?: Record<string, unknown>;
  heroMedia?: string;
  heroMediaAlt?: string;
}
const {
  locale,
  title,
  description,
  eyebrow,
  handle,
  meta = [],
  paper = false,
  image,
  ogType = "website",
  structuredData,
  heroMedia,
  heroMediaAlt = "",
} = Astro.props;
---

<BaseLayout
  locale={locale}
  title={title}
  description={description}
  handle={handle}
  image={image}
  ogType={ogType}
  structuredData={structuredData}
>
  <PageHero eyebrow={eyebrow} title={title} description={description} />
  {
    heroMedia && (
      <section class="detail-cinema frame">
        <div class="detail-cinema__hud">
          <>
            <span>SEQUENCE / 01</span>
            <span>VERIFIED LOCAL MEDIA</span>
          </>
        </div>
        <img src={heroMedia} alt={heroMediaAlt} width="1600" height="900" loading="eager" />
      </section>
    )
  }
  {
    paper ? (
      <article class="article-paper">
        <div class="prose">
          <slot />
        </div>
      </article>
    ) : (
      <section class="section">
        <div class="section-inner detail-layout">
          <article class="prose">
            <slot />
          </article>
          <aside class="detail-aside" aria-label="Metadata">
            <dl>
              {meta.map(([label, value]) => (
                <div>
                  <dt>{label}</dt>
                  <dd>{value}</dd>
                </div>
              ))}
            </dl>
          </aside>
        </div>
      </section>
    )
  }
  <slot name="after" />
</BaseLayout>
