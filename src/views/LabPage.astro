---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import { profile } from "../data/profile";
import type { Locale } from "../lib/i18n";
import { localePath } from "../lib/i18n";
import { withBase } from "../lib/urls";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const isEn = locale === "en";
const neuralWork = withBase(localePath("/work/neural-graphics-lab/", locale));
const neuralDemo = withBase(localePath("/demos/neural-denoising/", locale));
---

<BaseLayout
  locale={locale}
  title={isEn ? "Lab" : "实验室"}
  description={profile.bio[locale]}
  handle={profile.displayName}
>
  <PageHero
    eyebrow="LAB / IN PROGRESS"
    title={isEn ? "Learning, with the labels left on." : "保留标签的学习过程。"}
    description={isEn
      ? "This space is for unfinished research. Completed evidence stays linked as a baseline rather than being relabeled as a new experiment."
      : "这里仅记录未完成的研究；已完成的证据作为基线链接保留，不重新包装成新的实验。"}
  />
  <section class="section">
    <div class="section-inner lab-grid">
      <article class="card lab-card">
        <span class="status-badge">IN PROGRESS</span>
        <h3>{isEn ? "Temporal and neural graphics extensions" : "时间与神经图形扩展"}</h3>
        <p>
          {
            isEn
              ? "The next experiments build on the completed denoising workflow: temporal inputs, wider scene distributions, and failure analysis remain open questions."
              : "下一轮实验以已完成的降噪流程为基线，继续研究时间输入、更广场景分布和失败案例分析。"
          }
        </p>
        <ul class="tag-list">
          <li class="tag">PyTorch</li><li class="tag">ONNX</li><li class="tag">Neural Graphics</li>
        </ul>
        <div class="button-row" style="margin-top:18px;">
          <a class="button button-secondary" href={neuralWork}>
            {isEn ? "Open completed baseline" : "查看已完成基线"}
          </a>
          <a class="button button-secondary" href={neuralDemo}>
            {isEn ? "Run denoising Demo" : "运行降噪 Demo"}
          </a>
        </div>
      </article>
      <article class="card lab-card">
        <span class="status-badge">COURSE NOTES</span>
        <h3>{isEn ? "Deep learning foundations" : "深度学习基础"}</h3>
        <p>
          {
            isEn
              ? "Course exercises and reproductions stay as study records, with assumptions and failed attempts left visible."
              : "课程练习和复现作为学习记录保留，明确写出假设和失败尝试。"
          }
        </p>
        <ul class="tag-list">
          <li class="tag">CNN</li><li class="tag">Optimization</li><li class="tag">Reproduction</li>
        </ul>
      </article>
    </div>
  </section>
</BaseLayout>
