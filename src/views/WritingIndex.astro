---
import { getCollection, type CollectionEntry } from "astro:content";
import ArticleCard from "../components/ArticleCard.astro";
import PageHero from "../components/PageHero.astro";
import WritingModuleNav from "../components/WritingModuleNav.astro";
import { profile } from "../data/profile";
import { writingModules } from "../data/writing-modules";
import BaseLayout from "../layouts/BaseLayout.astro";
import type { Locale } from "../lib/i18n";
import { withBase } from "../lib/urls";
import { resolveReadingTime } from "../content/reading-time";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const isEn = locale === "en";
const allEntries = (await getCollection("writing")) as CollectionEntry<"writing">[];
const entries = allEntries.filter((entry) => entry.data.locale === "zh-CN" && !entry.data.draft);
const slugOf = (entry: (typeof entries)[number]) => entry.data.routeSlug;
const dateFormatter = new Intl.DateTimeFormat(isEn ? "en-US" : "zh-CN", {
  year: "numeric",
  month: "2-digit",
  day: "2-digit",
});
const moduleGroups = writingModules.map((module) => ({
  module,
  entries: entries
    .filter((entry) => entry.data.module === module.id)
    .sort((left, right) => left.data.articleOrder - right.data.articleOrder),
}));
const pageUrl = new URL(
  withBase(isEn ? "/en/writing/" : "/writing/"),
  Astro.site ?? Astro.url.origin,
).toString();
const copy = isEn
  ? {
      title: "Decisions, ordered into a working path.",
      description:
        "A six-track graphics curriculum plus an adjacent multimedia systems track. Every English card is an abstract; full articles are published in Chinese.",
      abstractNote: "ENGLISH ABSTRACT / CHINESE FULL TEXT",
      question: "Key question",
      enter: "Open module",
      empty: "The first published note for this module is being prepared.",
      adjacent: "ADJACENT SYSTEMS",
    }
  : {
      title: "把工程判断排成可走的路径。",
      description:
        "六条图形系统主线，加上一条相邻的多媒体系统轨道。每篇文章都保留假设、证据、取舍与可验证的失败路径。",
      abstractNote: "英文摘要 / 中文全文",
      question: "关键问题",
      enter: "进入模块",
      empty: "该模块的首篇文章正在整理中。",
      adjacent: "相邻系统",
    };
---

<BaseLayout
  locale={locale}
  title={isEn ? "Writing" : "文章"}
  description={isEn
    ? "Chinese full-text engineering notes with English abstracts."
    : "按技术模块组织的图形系统工程文章。"}
  handle={profile.displayName}
  structuredData={{
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    name: isEn ? "Graphics Systems Writing" : "图形系统技术文章",
    description: copy.description,
    url: pageUrl,
    inLanguage: locale,
    hasPart: entries.map((entry) => ({
      "@type": "BlogPosting",
      headline: isEn ? entry.data.englishTitle : entry.data.title,
      url: new URL(
        withBase(`/writing/${entry.data.routeSlug}/`),
        Astro.site ?? Astro.url.origin,
      ).toString(),
      inLanguage: "zh-CN",
    })),
  }}
>
  <PageHero eyebrow="WRITING / LEARNING PATH" title={copy.title} description={copy.description} />
  <section class="writing-index-intro" aria-label={isEn ? "Writing modules" : "文章模块"}>
    <div class="section-inner">
      {isEn && <p class="writing-language-note">{copy.abstractNote}</p>}
      <WritingModuleNav locale={locale} mode="anchors" />
    </div>
  </section>

  <div class="writing-module-stack">
    {
      moduleGroups.map(({ module, entries: moduleEntries }) => (
        <section
          id={`module-${module.id}`}
          class:list={["writing-module", module.adjacent && "writing-module--adjacent"]}
          aria-labelledby={`module-heading-${module.id}`}
        >
          <div class="section-inner">
            <div class="writing-module__heading">
              <div>
                <span class="index-mark">{module.code}</span>
                {module.adjacent && <span class="writing-module__adjacent">{copy.adjacent}</span>}
                <h2 id={`module-heading-${module.id}`}>{module.title[locale]}</h2>
              </div>
              <div class="writing-module__brief">
                <p>{module.description[locale]}</p>
                <p>
                  <span>{copy.question}</span>
                  {module.question[locale]}
                </p>
                <a
                  class="module-link"
                  href={withBase(`${isEn ? "/en" : ""}/writing/modules/${module.id}/`)}
                >
                  {copy.enter} <span aria-hidden="true">↗</span>
                </a>
              </div>
            </div>
            {moduleEntries.length > 0 ? (
              <div class="article-grid writing-module__grid">
                {moduleEntries.map((entry) => {
                  const readingTime = resolveReadingTime(entry);
                  return (
                    <ArticleCard
                      title={isEn ? entry.data.englishTitle : entry.data.title}
                      description={isEn ? entry.data.englishDescription : entry.data.description}
                      moduleId={entry.data.module}
                      date={dateFormatter.format(entry.data.publishedAt)}
                      dateTime={entry.data.publishedAt.toISOString()}
                      moduleLabel={module.title[locale]}
                      level={entry.data.level}
                      readingMinutes={readingTime.minutes}
                      readingTimeSource={readingTime.source}
                      locale={locale}
                      fullTextLanguage="zh-CN"
                      href={withBase(`/writing/${slugOf(entry)}/`)}
                    />
                  );
                })}
              </div>
            ) : (
              <p class="writing-module__empty">{copy.empty}</p>
            )}
          </div>
        </section>
      ))
    }
  </div>
</BaseLayout>
