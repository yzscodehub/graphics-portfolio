---
import { getCollection, type CollectionEntry } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import SectionHeading from "../components/SectionHeading.astro";
import ProjectCard from "../components/ProjectCard.astro";
import DemoCard from "../components/DemoCard.astro";
import ArticleCard from "../components/ArticleCard.astro";
import DemoShell from "../components/DemoShell.astro";
import WritingModuleNav from "../components/WritingModuleNav.astro";
import { profile } from "../data/profile";
import { site } from "../data/site";
import { writingModules } from "../data/writing-modules";
import { resolveReadingTime } from "../content/reading-time";
import type { Locale } from "../lib/i18n";
import { localePath } from "../lib/i18n";
import { withBase } from "../lib/urls";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const isEn = locale === "en";
const homeUrl = new URL(
  withBase(localePath("/", locale)),
  Astro.site ?? Astro.url.origin,
).toString();
const allProjects = (await getCollection("projects")) as CollectionEntry<"projects">[];
const allDemos = (await getCollection("demos")) as CollectionEntry<"demos">[];
const allWriting = (await getCollection("writing")) as CollectionEntry<"writing">[];
const projectOrder = [
  "engine-systems-explorer",
  "real-time-rendering-lab",
  "webgpu-compute-lab",
  "neural-graphics-lab",
];
const demoOrder = [
  "material-lighting",
  "render-graph",
  "gpu-particles",
  "shadow-aa",
  "path-tracer",
  "frame-inspector",
  "neural-denoising",
];
const projects = allProjects
  .filter((entry) => entry.data.locale === locale && !entry.data.draft)
  .sort(
    (left, right) =>
      projectOrder.indexOf(left.data.routeSlug) - projectOrder.indexOf(right.data.routeSlug),
  )
  .slice(0, 4);
const demos = allDemos
  .filter((entry) => entry.data.locale === locale && !entry.data.draft)
  .sort(
    (left, right) =>
      demoOrder.indexOf(left.data.routeSlug) - demoOrder.indexOf(right.data.routeSlug),
  )
  .slice(0, 7);
const publishedWriting = allWriting.filter(
  (entry) => entry.data.locale === "zh-CN" && !entry.data.draft,
);
const primaryWritingModules = writingModules.filter((module) => !module.adjacent);
const writing = primaryWritingModules
  .map(
    (module) =>
      publishedWriting
        .filter((entry) => entry.data.module === module.id)
        .sort((left, right) => left.data.articleOrder - right.data.articleOrder)[0],
  )
  .filter((entry): entry is CollectionEntry<"writing"> => Boolean(entry));
const dateFormatter = new Intl.DateTimeFormat(isEn ? "en-US" : "zh-CN", {
  year: "numeric",
  month: "2-digit",
  day: "2-digit",
});
type RoutedEntry =
  CollectionEntry<"projects"> | CollectionEntry<"demos"> | CollectionEntry<"writing">;
const slugOf = (entry: RoutedEntry) => entry.data.routeSlug;

const copy = isEn
  ? {
      heroEyebrow: "Graphics Systems Engineer / Public Lab",
      heroTitle: "I build the systems behind real-time graphics.",
      heroLede:
        "Rendering, engine architecture, GPU compute and multimedia systems — with neural graphics explored through reproducible experiments.",
      primary: "Explore work",
      secondary: "Run demos",
      workLabel: "Selected work",
      workTitle: "Systems, made observable.",
      workDescription:
        "Four public projects turn low-level graphics concepts into inspectable, runnable case studies.",
      demoLabel: "Public prototypes",
      demoTitle: "Eight focused rendering-system studies.",
      demoDescription:
        "Each prototype states its current backend, implemented controls, limitations and planned next step.",
      evidenceLabel: "Professional evidence",
      evidenceTitle: "Experience without disclosure.",
      evidenceDescription:
        "Anonymous, reviewable capability signals grounded in real graphics systems work.",
      writingLabel: "Technical writing",
      writingTitle: "Decisions, not recipes.",
      writingDescription:
        "Six module entry points connect abstractions, measurements, tradeoffs and failure modes.",
      labLabel: "Current lab",
      labTitle: "Learning in public.",
      labDescription:
        "The reviewed single-frame denoiser is complete; the lab now tracks temporal stability and richer rendering features as the next research boundary.",
      contactTitle: "Let’s talk about the hard parts of graphics systems.",
      github: "GitHub",
    }
  : {
      heroEyebrow: "图形系统工程师 / 公开实验室",
      heroTitle: "构建实时图形背后的系统。",
      heroLede: "专注渲染、引擎架构、GPU Compute 与多媒体系统，并以可复现实验探索神经图形。",
      primary: "查看项目",
      secondary: "运行 Demo",
      workLabel: "精选项目",
      workTitle: "让系统变得可观察。",
      workDescription: "四个公开项目把底层图形概念整理为可检查、可运行、可复盘的案例。",
      demoLabel: "公开技术原型",
      demoTitle: "八个聚焦的渲染系统研究。",
      demoDescription: "每个原型明确说明当前后端、已实现控件、限制和下一步路线。",
      evidenceLabel: "职业能力证据",
      evidenceTitle: "脱敏，但不空泛。",
      evidenceDescription: "以匿名、可审核的能力线索呈现真实图形系统经验。",
      writingLabel: "技术写作",
      writingTitle: "记录判断，而不只是步骤。",
      writingDescription: "六条技术主线把抽象、测量、取舍和失败路径连接起来。",
      labLabel: "当前实验室",
      labTitle: "公开学习过程。",
      labDescription:
        "已审核的单帧降噪器已经完成；实验室下一阶段研究时域稳定性与更丰富的渲染特征。",
      contactTitle: "一起讨论图形系统中真正困难的部分。",
      github: "GitHub",
    };
---

<BaseLayout
  locale={locale}
  title={profile.role[locale]}
  description={profile.bio[locale]}
  handle={profile.displayName}
  structuredData={[
    {
      "@context": "https://schema.org",
      "@type": "Person",
      name: profile.displayName,
      jobTitle: profile.role[locale],
      description: profile.bio[locale],
      url: homeUrl,
      sameAs: [profile.githubUrl],
    },
    {
      "@context": "https://schema.org",
      "@type": "WebSite",
      name: site.name,
      url: homeUrl,
      inLanguage: locale,
    },
  ]}
>
  <section class="hero">
    <div class="hero-grid">
      <div class="hero-copy-panel">
        <div>
          <span class="eyebrow">{copy.heroEyebrow}</span>
          <h1>{copy.heroTitle}</h1>
          <p class="hero-lede">{copy.heroLede}</p>
          <div class="hero-actions">
            <a class="button button-primary" href={withBase(localePath("/work/", locale))}
              >{copy.primary}</a
            >
            <a class="button button-secondary" href={withBase(localePath("/demos/", locale))}
              >{copy.secondary}</a
            >
          </div>
        </div>
        <div class="hero-meta">
          <span>RHI / PIPELINE</span><span>GPU / COMPUTE</span><span>MEDIA / SYNC</span><span
            >STAGE / {site.features.stage.toUpperCase()}</span
          >
        </div>
      </div>
      <div class="hero-demo-panel">
        <div class="hero-cinematic-frame" aria-hidden="true">
          <div class="hero-cinematic-matte hero-cinematic-matte--top"></div>
          <div class="hero-cinematic-matte hero-cinematic-matte--bottom"></div>
          <div class="hero-calibration-line"><span></span></div>
          <div class="hero-light-reveal"></div>
          <div class="hero-exposure-slate">
            <span>21:9 / CALIBRATION</span><span>EXPOSURE +0.7</span>
          </div>
        </div>
        <div class="hero-demo-poster" aria-hidden="true"><div class="calibration-orb"></div></div>
        <div class="demo-hud">
          <span>DEMO_01</span><strong>MATERIAL / LIGHTING</strong><span>AUTO BACKEND</span>
        </div>
        <DemoShell
          class="hero-demo-shell"
          slug="material-lighting"
          locale={locale}
          title="Material & Lighting"
          fallbackImage="/media/demos/material-lighting-poster.svg"
          description={isEn ? "Interactive PBR calibration scene." : "交互式 PBR 校准场景。"}
        />
      </div>
    </div>
  </section>

  <div class="signal-rail" aria-label="Focus areas">
    <div class="signal-track">{profile.focus.map((item) => <span>{item}</span>)}</div>
  </div>

  <section class="home-learning-path frame" aria-labelledby="home-learning-path-title">
    <div class="home-learning-path__heading">
      <span>{isEn ? "TECHNICAL MODULES / READING MAP" : "技术模块 / 阅读地图"}</span>
      <h2 id="home-learning-path-title">
        {isEn ? "Follow the rendering system, layer by layer." : "沿着渲染系统逐层阅读。"}
      </h2>
    </div>
    <WritingModuleNav locale={locale} />
  </section>

  <section class="section">
    <div class="section-inner">
      <SectionHeading
        index="01"
        label={copy.workLabel}
        title={copy.workTitle}
        description={copy.workDescription}
      />
      <div class="work-grid">
        {
          projects.map((entry, index) => (
            <ProjectCard
              index={index + 1}
              title={entry.data.title}
              description={entry.data.summary}
              tags={entry.data.technologies.slice(0, 5)}
              status={entry.data.status}
              href={withBase(localePath(`/work/${slugOf(entry)}/`, locale))}
            />
          ))
        }
      </div>
    </div>
  </section>

  <section class="section">
    <div class="section-inner">
      <SectionHeading
        index="02"
        label={copy.demoLabel}
        title={copy.demoTitle}
        description={copy.demoDescription}
      />
      <div class="demo-grid">
        {
          demos.map((entry) => (
            <DemoCard
              title={entry.data.title}
              description={entry.data.summary}
              backend={entry.data.backend}
              category={entry.data.category}
              status={entry.data.status}
              href={withBase(localePath(`/demos/${slugOf(entry)}/`, locale))}
            />
          ))
        }
      </div>
    </div>
  </section>

  <section class="section">
    <div class="section-inner">
      <SectionHeading
        index="03"
        label={copy.evidenceLabel}
        title={copy.evidenceTitle}
        description={copy.evidenceDescription}
      />
      <div class="evidence-grid">
        <article class="card evidence-card reveal">
          <span class="data-label">ENGINE</span><strong>RHI</strong><p>
            {
              isEn
                ? "Cross-API boundaries, resource lifetime and pipeline-state ownership."
                : "跨 API 边界、资源生命周期与管线状态所有权。"
            }
          </p>
        </article>
        <article class="card evidence-card reveal">
          <span class="data-label">GPU</span><strong>FRAME</strong><p>
            {
              isEn
                ? "Measure frame time, bandwidth, synchronization and data layout before optimizing."
                : "在优化前先测量帧时间、带宽、同步与数据布局。"
            }
          </p>
        </article>
        <article class="card evidence-card reveal">
          <span class="data-label">MEDIA</span><strong>A/V</strong><p>
            {
              isEn
                ? "High-resolution media paths with explicit clocks, queues and copy boundaries."
                : "以显式时钟、队列和拷贝边界组织高分辨率媒体链路。"
            }
          </p>
        </article>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="section-inner">
      <SectionHeading
        index="04"
        label={copy.writingLabel}
        title={copy.writingTitle}
        description={copy.writingDescription}
      />
      <div class="article-grid">
        {
          writing.map((entry) => {
            const readingTime = resolveReadingTime(entry);
            return (
              <ArticleCard
                title={isEn ? entry.data.englishTitle : entry.data.title}
                description={isEn ? entry.data.englishDescription : entry.data.description}
                moduleId={entry.data.module}
                date={dateFormatter.format(entry.data.publishedAt)}
                dateTime={entry.data.publishedAt.toISOString()}
                moduleLabel={
                  writingModules.find((module) => module.id === entry.data.module)?.title[locale]
                }
                level={entry.data.level}
                readingMinutes={readingTime.minutes}
                readingTimeSource={readingTime.source}
                locale={locale}
                fullTextLanguage="zh-CN"
                href={withBase(`/writing/${slugOf(entry)}/`)}
              />
            );
          })
        }
      </div>
    </div>
  </section>

  <section class="section">
    <div class="section-inner">
      <SectionHeading
        index="05"
        label={copy.labLabel}
        title={copy.labTitle}
        description={copy.labDescription}
      />
      <div class="lab-grid">
        <article class="card lab-card reveal">
          <span class="status-badge">NEXT STUDY</span><h3>
            Temporal denoising / feature buffers
          </h3><p>
            {
              isEn
                ? "Test motion, history rejection, albedo and normal features without presenting the completed single-frame model as unfinished work."
                : "研究运动、历史拒绝以及 Albedo/Normal 特征，不再把已经完成的单帧模型标成进行中。"
            }
          </p>
        </article>
        <article class="card lab-card reveal">
          <span class="status-badge">READING</span><h3>Deep learning foundations</h3><p>
            {
              isEn
                ? "Course notes and reproductions remain learning records, never presented as original research."
                : "课程笔记与复现只作为学习记录，不包装成原创研究。"
            }
          </p>
        </article>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="section-inner contact-panel reveal">
      <div><span class="kicker">CONTACT / OPEN CHANNEL</span><h2>{copy.contactTitle}</h2></div>
      <div class="contact-actions">
        <a class="button button-primary" href={profile.githubUrl} rel="me" data-contact-link>
          {copy.github}
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
