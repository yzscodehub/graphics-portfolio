---
import { getCollection, type CollectionEntry } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import DemoCard from "../components/DemoCard.astro";
import { profile } from "../data/profile";
import { compareDemoSlugs } from "../data/demo-order";
import type { Locale } from "../lib/i18n";
import { localePath } from "../lib/i18n";
import { withBase } from "../lib/urls";

interface Props {
  locale: Locale;
}

type DemoBackend = { id: string; label: string; role: string };
type DemoRequirement = string | { label: string };
type DemoFallback = { kind: string; description: string };
type DemoMetricSource = { kind: string; description: string } | string;
type DemoPresentationData = {
  maturity?: string;
  evidence?: string;
  backends?: DemoBackend[];
  requirements?: DemoRequirement[];
  fallback?: DemoFallback;
  metricSource?: DemoMetricSource;
  assetIds?: string[];
  modes?: string[];
  sourceUrl?: string;
};

const { locale } = Astro.props;
const isEn = locale === "en";
const allEntries = (await getCollection("demos")) as CollectionEntry<"demos">[];
const entries = allEntries
  .filter((entry) => entry.data.locale === locale && !entry.data.draft)
  .sort((left, right) => compareDemoSlugs(left.data.routeSlug, right.data.routeSlug));
const slugOf = (entry: (typeof entries)[number]) => entry.data.routeSlug;
const categories = ["all", "rendering", "engine", "gpu", "machine-learning"];
const completedCount = entries.filter((entry) => entry.data.maturity === "completed").length;
const inProgressCount = entries.length - completedCount;
const maturitySummary = isEn
  ? `${completedCount} completed / ${inProgressCount} in progress. Every Demo names its backend, requirements, evidence source, and current implementation limit.`
  : `${completedCount} 项已完成 / ${inProgressCount} 项进行中。每项 Demo 都明确后端、要求、证据来源与当前实现边界。`;

function presentationData(entry: (typeof entries)[number]): DemoPresentationData {
  return entry.data as typeof entry.data & DemoPresentationData;
}

function backendText(data: DemoPresentationData): string {
  return data.backends?.map((backend) => `${backend.id} · ${backend.role}`).join(" / ") ?? "—";
}

function requirementText(data: DemoPresentationData): string {
  return (
    data.requirements
      ?.map((requirement) => (typeof requirement === "string" ? requirement : requirement.label))
      .join(" / ") ?? "—"
  );
}

function metricSourceText(data: DemoPresentationData): string {
  if (!data.metricSource) return isEn ? "No numeric claim" : "无数值声明";
  return typeof data.metricSource === "string"
    ? data.metricSource
    : `${data.metricSource.kind} · ${data.metricSource.description}`;
}

function fallbackText(data: DemoPresentationData): string {
  return data.fallback
    ? `${data.fallback.kind} · ${data.fallback.description}`
    : isEn
      ? "Static preview"
      : "静态预览";
}
---

<BaseLayout
  locale={locale}
  title={isEn ? "Demos" : "演示"}
  description={isEn
    ? "Eight published rendering-system studies with explicit maturity, evidence, and fallback paths."
    : "八个已发布的渲染系统研究，明确展示成熟度、证据、回退和指标来源。"}
  handle={profile.displayName}
>
  <PageHero
    eyebrow="DEMOS / RUNTIME"
    title={isEn ? "Evidence you can inspect." : "可以检查的技术证据。"}
    description={maturitySummary}
  />
  <section class="section">
    <div class="section-inner">
      <div class="filter-bar" data-filter-group aria-label={isEn ? "Filter demos" : "筛选演示"}>
        {
          categories.map((category, index) => (
            <button
              class="filter-chip"
              type="button"
              data-filter={category}
              aria-pressed={index === 0 ? "true" : "false"}
            >
              {category}
            </button>
          ))
        }
      </div>
      <div class="demo-grid">
        {
          entries.map((entry) => {
            const data = presentationData(entry);
            return (
              <div class="demo-listing" style="display:flex; flex-direction:column; min-width:0;">
                <DemoCard
                  title={entry.data.title}
                  description={entry.data.summary}
                  backend={entry.data.backend}
                  category={entry.data.category}
                  status={data.maturity ?? "completed"}
                  href={withBase(localePath(`/demos/${slugOf(entry)}/`, locale))}
                />
                <dl
                  class="demo-listing__evidence"
                  style="display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:8px 12px; margin:0; padding:14px 18px 18px; border-right:1px solid var(--line); border-bottom:1px solid var(--line); background:rgba(15,21,24,.35); font:0.65rem/1.45 var(--font-mono,ui-monospace,monospace);"
                >
                  <div>
                    <>
                      <dt style="color:var(--dim);">EVIDENCE</dt>
                      <dd style="margin:2px 0 0; color:var(--signal);">
                        {data.evidence ?? "verified"}
                      </dd>
                    </>
                  </div>
                  <div>
                    <>
                      <dt style="color:var(--dim);">BACKENDS</dt>
                      <dd style="margin:2px 0 0; color:var(--muted);">{backendText(data)}</dd>
                    </>
                  </div>
                  <div>
                    <>
                      <dt style="color:var(--dim);">REQUIRES</dt>
                      <dd style="margin:2px 0 0; color:var(--muted);">{requirementText(data)}</dd>
                    </>
                  </div>
                  <div>
                    <>
                      <dt style="color:var(--dim);">FALLBACK</dt>
                      <dd style="margin:2px 0 0; color:var(--muted);">{fallbackText(data)}</dd>
                    </>
                  </div>
                  <div>
                    <>
                      <dt style="color:var(--dim);">MODES</dt>
                      <dd style="margin:2px 0 0; color:var(--muted);">
                        {data.modes?.join(" / ") || "single"}
                      </dd>
                    </>
                  </div>
                  <div>
                    <>
                      <dt style="color:var(--dim);">ASSETS</dt>
                      <dd style="margin:2px 0 0; color:var(--muted);">
                        {data.assetIds?.join(" / ") || "procedural"}
                      </dd>
                    </>
                  </div>
                  <div style="grid-column:1 / -1;">
                    <>
                      <dt style="color:var(--dim);">METRIC SOURCE</dt>
                      <dd style="margin:2px 0 0; color:var(--muted);">{metricSourceText(data)}</dd>
                    </>
                  </div>
                </dl>
              </div>
            );
          })
        }
      </div>
    </div>
  </section>
</BaseLayout>
